<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="create-dokument" author="chris">

        <createTable tableName="dokument">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_dokument"
                        nullable="false"/>
            </column>

            <column name="beleg_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>

            <column name="zahlungsnachweis_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>

            <column name="reihenfolge" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="titel" type="VARCHAR(200)"/>

            <column name="original_dateiname" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="mime_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="dateigroesse" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="inhalt" type="BYTEA">
                <constraints nullable="false"/>
            </column>

            <!-- Bild-/Dokumentgeometrie -->

            <column name="bild_breite_pixel" type="INTEGER"/>

            <column name="bild_hoehe_pixel" type="INTEGER"/>

            <column name="dokument_breite_mm" type="DOUBLE PRECISION"/>

            <column name="dokument_hoehe_mm" type="DOUBLE PRECISION"/>

            <!-- Referenzobjekt -->

            <column name="referenz_objekt" type="VARCHAR(50)"/>

            <!-- Audit -->

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <column name="created_by" type="VARCHAR(255)"/>

            <column name="last_modified_at" type="TIMESTAMP WITH TIME ZONE"/>

            <column name="last_modified_by" type="VARCHAR(255)"/>

        </createTable>


        <!-- Foreign Keys -->

        <addForeignKeyConstraint
                baseTableName="dokument"
                baseColumnNames="beleg_id"
                referencedTableName="abrechnung_beleg"
                referencedColumnNames="id"
                constraintName="fk_dokument_beleg"/>

        <addForeignKeyConstraint
                baseTableName="dokument"
                baseColumnNames="zahlungsnachweis_id"
                referencedTableName="zahlungsnachweis"
                referencedColumnNames="id"
                constraintName="fk_dokument_zahlungsnachweis"/>


        <!-- Indizes -->

        <createIndex
                indexName="idx_dokument_beleg"
                tableName="dokument">

            <column name="beleg_id"/>

        </createIndex>

        <createIndex
                indexName="idx_dokument_zahlungsnachweis"
                tableName="dokument">

            <column name="zahlungsnachweis_id"/>

        </createIndex>


        <!--
            Ein Dokument gehört genau einem Besitzer:
            entweder AbrechnungBeleg oder Zahlungsnachweis.
        -->

        <sql>
            ALTER TABLE dokument
            ADD CONSTRAINT chk_dokument_besitzer
            CHECK (
            (beleg_id IS NOT NULL AND zahlungsnachweis_id IS NULL)
            OR
            (beleg_id IS NULL AND zahlungsnachweis_id IS NOT NULL)
            );
        </sql>

    </changeSet>

</databaseChangeLog>