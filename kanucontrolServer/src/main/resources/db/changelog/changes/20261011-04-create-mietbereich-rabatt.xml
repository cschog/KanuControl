<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="create-mietbereich-rabatt" author="kc">

        <createTable tableName="mietbereich_rabatt">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_mietbereich_rabatt"
                        nullable="false"/>
            </column>

            <column name="mietbereich_id" type="BIGINT">
                <constraints
                        nullable="false"
                        foreignKeyName="fk_mietbereich_rabatt_mietbereich"
                        references="mietbereich(id)"/>
            </column>

            <column name="rabattart" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="rabattwert_typ" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="rabattwert" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>

            <column name="aktiv" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <!-- Audit-Spalten entsprechend Auditable -->

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <column name="created_by" type="VARCHAR(255)"/>

            <column name="last_modified_at" type="TIMESTAMP WITH TIME ZONE"/>

            <column name="last_modified_by" type="VARCHAR(255)"/>

        </createTable>

        <addUniqueConstraint
                tableName="mietbereich_rabatt"
                columnNames="mietbereich_id,rabattart"
                constraintName="uk_mietbereich_rabatt_art"/>

    </changeSet>

</databaseChangeLog>