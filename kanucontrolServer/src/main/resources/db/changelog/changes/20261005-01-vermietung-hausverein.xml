<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="20261005-01-vermietung-hausverein" author="chris">

        <!-- Erster Verein eines Tenants kann automatisch Hausverein werden -->
        <addColumn tableName="verein">
            <column name="hausverein"
                    type="BOOLEAN"
                    defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <!-- Mietobjekte gehören nicht zu einem Verein -->
        <dropForeignKeyConstraint
                baseTableName="mietobjekt"
                constraintName="fk_mietobjekt_verein"/>

        <dropColumn
                tableName="mietobjekt"
                columnName="verein_id"/>

    </changeSet>

</databaseChangeLog>