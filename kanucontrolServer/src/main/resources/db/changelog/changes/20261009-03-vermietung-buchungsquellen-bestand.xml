<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20261009-03-vermietung-buchungsquellen-bestand"
               author="kanucontrol">

        <!-- Mietobjekt -->
        <addColumn tableName="mietobjekt">
            <column name="direktbuchung_aktiv"
                    type="BOOLEAN"
                    defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="airbnb_aktiv"
                    type="BOOLEAN"
                    defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <!-- Mietbereich -->
        <addColumn tableName="mietbereich">
            <column name="direktbuchung_aktiv"
                    type="BOOLEAN"
                    defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="airbnb_aktiv"
                    type="BOOLEAN"
                    defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="bestand"
                    type="INTEGER"
                    defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="mengeneinheit"
                    type="VARCHAR(50)"/>
        </addColumn>

        <!-- Buchungsposition -->
        <addColumn tableName="buchung_mietbereich">
            <column name="anzahl"
                    type="INTEGER"
                    defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </addColumn>

    </changeSet>

</databaseChangeLog>