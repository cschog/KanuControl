<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="20260807-01-zahlungsnachweis" author="chris">

        <createTable tableName="zahlungsnachweis">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"
                             primaryKeyName="pk_zahlungsnachweis"
                             nullable="false"/>
            </column>

            <column name="veranstaltung_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="art" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>

            <column name="datum" type="DATE"/>

            <column name="bemerkung" type="VARCHAR(1000)"/>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="created_by" type="VARCHAR(255)"/>

            <column name="updated_at" type="TIMESTAMP"/>

            <column name="updated_by" type="VARCHAR(255)"/>

        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_zn_veranstaltung"
                baseTableName="zahlungsnachweis"
                baseColumnNames="veranstaltung_id"
                referencedTableName="veranstaltung"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <createIndex
                tableName="zahlungsnachweis"
                indexName="idx_zn_veranstaltung">

            <column name="veranstaltung_id"/>

        </createIndex>

    </changeSet>

</databaseChangeLog>