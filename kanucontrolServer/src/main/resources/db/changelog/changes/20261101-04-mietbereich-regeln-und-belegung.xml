<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261101-04-mietbereich-regeln-und-belegung" author="chris">
        <createTable tableName="mietbereich_voraussetzung_airbnb">
            <column name="mietbereich_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_mietbereich_voraus_airbnb"/>
            </column>
            <column name="erforderlicher_mietbereich_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_mietbereich_voraus_airbnb"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="mietbereich_voraussetzung_airbnb"
                baseColumnNames="mietbereich_id"
                constraintName="fk_mb_voraus_airbnb_bereich"
                referencedTableName="mietbereich"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
        <addForeignKeyConstraint
                baseTableName="mietbereich_voraussetzung_airbnb"
                baseColumnNames="erforderlicher_mietbereich_id"
                constraintName="fk_mb_voraus_airbnb_erforderlich"
                referencedTableName="mietbereich"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <createTable tableName="mietbereich_belegung">
            <column name="mietbereich_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_mietbereich_belegung"/>
            </column>
            <column name="belegter_mietbereich_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_mietbereich_belegung"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="mietbereich_belegung"
                baseColumnNames="mietbereich_id"
                constraintName="fk_mietbereich_belegung_bereich"
                referencedTableName="mietbereich"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
        <addForeignKeyConstraint
                baseTableName="mietbereich_belegung"
                baseColumnNames="belegter_mietbereich_id"
                constraintName="fk_mietbereich_belegung_teilbereich"
                referencedTableName="mietbereich"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
