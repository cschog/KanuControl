<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">
 <changeSet id="20261113-03-buchungsdokumente" author="codex">
  <addColumn tableName="buchung"><column name="fruehere_buchungsnummer" type="VARCHAR(100)"/></addColumn>
  <addColumn tableName="vermietung_nachrichtenentwurf">
   <column name="unabhaengig" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
   <column name="aktuelle_fassung" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
   <column name="dokument_am" type="TIMESTAMP WITH TIME ZONE"/>
   <column name="hinweise" type="TEXT" defaultValue="[]"/>
  </addColumn>
  <addColumn tableName="vermietung_vorlagenversand"><column name="versand_schluessel" type="VARCHAR(36)"><constraints unique="true" uniqueConstraintName="uk_vorlagenversand_schluessel"/></column></addColumn>
  <sql>CREATE UNIQUE INDEX uk_buchungsdokument_aktuell ON vermietung_nachrichtenentwurf(tenant,buchung_id,ziel) WHERE unabhaengig = true AND aktuelle_fassung = true</sql>
 </changeSet>
</databaseChangeLog>
