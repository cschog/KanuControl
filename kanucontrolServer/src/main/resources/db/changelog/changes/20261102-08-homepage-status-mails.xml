<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">
    <changeSet id="20261102-08-homepage-status-mails" author="codex">
        <createTable tableName="homepage_status_mail">
            <column name="id" type="VARCHAR(36)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="mietobjekt_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="buchung_id" type="BIGINT"/>
            <column name="buchungsnummer" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="empfaenger" type="VARCHAR(254)"><constraints nullable="false"/></column>
            <column name="reply_to" type="VARCHAR(254)"/>
            <column name="betreff" type="VARCHAR(300)"><constraints nullable="false"/></column>
            <column name="text" type="TEXT"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="quittiert_am" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="homepage_status_mail" baseColumnNames="mietobjekt_id"
            referencedTableName="mietobjekt" referencedColumnNames="id" constraintName="fk_homepage_status_objekt" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="homepage_status_mail" baseColumnNames="buchung_id"
            referencedTableName="buchung" referencedColumnNames="id" constraintName="fk_homepage_status_buchung" onDelete="SET NULL"/>
        <createIndex tableName="homepage_status_mail" indexName="idx_homepage_status_offen">
            <column name="mietobjekt_id"/><column name="quittiert_am"/><column name="created_at"/>
        </createIndex>
        <rollback><dropTable tableName="homepage_status_mail"/></rollback>
    </changeSet>
</databaseChangeLog>
