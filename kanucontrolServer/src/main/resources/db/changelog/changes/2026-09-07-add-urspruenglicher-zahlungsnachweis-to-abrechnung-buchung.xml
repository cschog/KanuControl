<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet
            id="2026-09-07-add-urspruenglicher-zahlungsnachweis"
            author="chris">

        <!-- =====================================================
             SPALTE
             ===================================================== -->

        <addColumn tableName="abrechnung_buchung">

            <column
                    name="urspruenglicher_zahlungsnachweis_id"
                    type="BIGINT"/>

        </addColumn>


        <!-- =====================================================
             FOREIGN KEY
             ===================================================== -->

        <addForeignKeyConstraint
                constraintName="fk_abrechnung_buchung_urspruenglicher_zn"
                baseTableName="abrechnung_buchung"
                baseColumnNames="urspruenglicher_zahlungsnachweis_id"
                referencedTableName="zahlungsnachweis"
                referencedColumnNames="id"
                onDelete="SET NULL"/>


        <!-- =====================================================
             INDEX
             ===================================================== -->

        <createIndex
                tableName="abrechnung_buchung"
                indexName="idx_abrechnung_buchung_urspr_zn">

            <column
                    name="urspruenglicher_zahlungsnachweis_id"/>

        </createIndex>

    </changeSet>

</databaseChangeLog>