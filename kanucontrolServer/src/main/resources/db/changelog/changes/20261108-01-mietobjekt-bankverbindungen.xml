<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">
    <changeSet id="20261108-01-mietobjekt-bankverbindungen" author="chris">
        <addColumn tableName="mietobjekt">
            <column name="bank_primaer_kontoinhaber" type="VARCHAR(255)"/>
            <column name="bank_primaer_name" type="VARCHAR(255)"/>
            <column name="bank_primaer_iban" type="VARCHAR(34)"/>
            <column name="bank_primaer_bic" type="VARCHAR(11)"/>
            <column name="bank_alternativ_kontoinhaber" type="VARCHAR(255)"/>
            <column name="bank_alternativ_name" type="VARCHAR(255)"/>
            <column name="bank_alternativ_iban" type="VARCHAR(34)"/>
            <column name="bank_alternativ_bic" type="VARCHAR(11)"/>
        </addColumn>
        <addColumn tableName="buchung">
            <column name="bankverbindung_auswahl" type="VARCHAR(20)" defaultValue="PRIMAER">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="buchung" columnName="bankverbindung_auswahl"/>
            <dropColumn tableName="mietobjekt" columnName="bank_primaer_kontoinhaber"/>
            <dropColumn tableName="mietobjekt" columnName="bank_primaer_name"/>
            <dropColumn tableName="mietobjekt" columnName="bank_primaer_iban"/>
            <dropColumn tableName="mietobjekt" columnName="bank_primaer_bic"/>
            <dropColumn tableName="mietobjekt" columnName="bank_alternativ_kontoinhaber"/>
            <dropColumn tableName="mietobjekt" columnName="bank_alternativ_name"/>
            <dropColumn tableName="mietobjekt" columnName="bank_alternativ_iban"/>
            <dropColumn tableName="mietobjekt" columnName="bank_alternativ_bic"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
