<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="create-verbrauchskosten" author="kc">

        <createTable tableName="verbrauchskosten">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"
                             primaryKeyName="pk_verbrauchskosten"
                             nullable="false"/>
            </column>

            <column name="mietobjekt_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_verbrauchskosten_mietobjekt"
                             references="mietobjekt(id)"/>
            </column>

            <column name="bezeichnung" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="abrechnungsart" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="mengeneinheit" type="VARCHAR(20)"/>

            <column name="preis" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>

            <column name="aktiv" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <!-- Audit-Spalten gemäß Auditable prüfen und ergänzen -->

        </createTable>

    </changeSet>

</databaseChangeLog>