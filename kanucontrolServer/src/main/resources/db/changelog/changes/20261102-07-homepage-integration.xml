<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">
    <changeSet id="20261102-07-homepage-integration" author="codex">
        <addColumn tableName="homepage_anbindung">
            <column name="aktiv" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="technischer_client_id" type="VARCHAR(200)"/>
        </addColumn>
        <addColumn tableName="buchung"><column name="herkunft" type="VARCHAR(40)"/></addColumn>
        <createTable tableName="homepage_anfrage">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="mietobjekt_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="anfrage_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
            <column name="payload_hash" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="antwort_json" type="TEXT"><constraints nullable="false"/></column>
            <column name="hinweis_stand" type="TEXT"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="homepage_anfrage" columnNames="mietobjekt_id,anfrage_id" constraintName="uk_homepage_anfrage"/>
        <addForeignKeyConstraint baseTableName="homepage_anfrage" baseColumnNames="mietobjekt_id"
            referencedTableName="mietobjekt" referencedColumnNames="id" constraintName="fk_homepage_anfrage_objekt" onDelete="CASCADE"/>
        <rollback>
            <dropTable tableName="homepage_anfrage"/>
            <dropColumn tableName="buchung" columnName="herkunft"/>
            <dropColumn tableName="homepage_anbindung" columnName="technischer_client_id"/>
            <dropColumn tableName="homepage_anbindung" columnName="aktiv"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
