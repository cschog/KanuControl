<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="2026-09-13-rueckzahlung-zahlungsnachweis" author="kcserver">

        <!--
            Rückzahlungen werden künftig als Zahlungsnachweis gespeichert.
            Die Rückzahlung referenziert den ursprünglichen Zahlungsnachweis.
        -->
        <addColumn tableName="zahlungsnachweis">
            <column
                    name="urspruenglicher_zahlungsnachweis_id"
                    type="BIGINT">
                <constraints
                        nullable="true"
                        foreignKeyName="fk_zahlungsnachweis_ursprung"
                        referencedTableName="zahlungsnachweis"
                        referencedColumnNames="id"/>
            </column>
        </addColumn>

        <!--
            Alte Referenz aus AbrechnungBuchung entfernen.
            Rückzahlungen werden nicht mehr als AbrechnungBuchung gespeichert.
        -->
        <dropColumn
                tableName="abrechnung_buchung"
                columnName="urspruenglicher_zahlungsnachweis_id"/>

    </changeSet>

</databaseChangeLog>