<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="2026-09-14-create-finanzausgleich-zahlung" author="kcserver">

        <!--
            Tatsächlich geleistete Zahlungen des VK an eine Finanzgruppe.
            Der Betrag wird zum Zeitpunkt der Zahlung festgeschrieben
            und ist damit unabhängig von späteren Änderungen
            der Finanzausgleichsberechnung.
        -->
        <createTable tableName="finanzausgleich_zahlung">

            <column
                    name="id"
                    type="BIGINT"
                    autoIncrement="true">
                <constraints
                        nullable="false"
                        primaryKey="true"
                        primaryKeyName="pk_finanzausgleich_zahlung"/>
            </column>

            <column
                    name="finanz_gruppe_id"
                    type="BIGINT">
                <constraints
                        nullable="false"
                        foreignKeyName="fk_finanzausgleich_zahlung_finanzgruppe"
                        referencedTableName="finanz_gruppe"
                        referencedColumnNames="id"/>
            </column>

            <column
                    name="betrag"
                    type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>

            <column
                    name="datum"
                    type="DATE">
                <constraints nullable="false"/>
            </column>

            <column
                    name="bemerkung"
                    type="VARCHAR(500)"/>

        </createTable>

        <createIndex
                indexName="idx_finanzausgleich_zahlung_finanzgruppe"
                tableName="finanzausgleich_zahlung">

            <column name="finanz_gruppe_id"/>

        </createIndex>

        <!--
            Dokumente können als Nachweis einer
            FinanzausgleichZahlung zugeordnet werden.
        -->
        <addColumn tableName="dokument">

            <column
                    name="finanzausgleich_zahlung_id"
                    type="BIGINT">
                <constraints
                        nullable="true"
                        foreignKeyName="fk_dokument_finanzausgleich_zahlung"
                        referencedTableName="finanzausgleich_zahlung"
                        referencedColumnNames="id"/>
            </column>

        </addColumn>

        <createIndex
                indexName="idx_dokument_finanzausgleich_zahlung"
                tableName="dokument">

            <column name="finanzausgleich_zahlung_id"/>

        </createIndex>

    </changeSet>

</databaseChangeLog>