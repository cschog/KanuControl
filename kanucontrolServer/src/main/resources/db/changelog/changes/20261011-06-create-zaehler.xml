<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Zähler -->
    <changeSet id="create-zaehler" author="kc">
        <createTable tableName="zaehler">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"
                             primaryKeyName="pk_zaehler"
                             nullable="false"/>
            </column>

            <column name="mietobjekt_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="bezeichnung" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="verbrauchsart" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="zaehlernummer" type="VARCHAR(100)"/>

            <column name="mengeneinheit" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="aktiv" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="last_modified_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="last_modified_by" type="VARCHAR(255)"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="zaehler"
                baseColumnNames="mietobjekt_id"
                referencedTableName="mietobjekt"
                referencedColumnNames="id"
                constraintName="fk_zaehler_mietobjekt"/>
    </changeSet>

    <!-- Zählerstände -->
    <changeSet id="create-zaehlerstand" author="kc">
        <createTable tableName="zaehlerstand">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"
                             primaryKeyName="pk_zaehlerstand"
                             nullable="false"/>
            </column>

            <column name="zaehler_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="ablesedatum" type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <column name="zaehlerstand" type="NUMERIC(15,3)">
                <constraints nullable="false"/>
            </column>

            <column name="bemerkung" type="VARCHAR(1000)"/>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="last_modified_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="last_modified_by" type="VARCHAR(255)"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="zaehlerstand"
                baseColumnNames="zaehler_id"
                referencedTableName="zaehler"
                referencedColumnNames="id"
                constraintName="fk_zaehlerstand_zaehler"/>
    </changeSet>

    <!-- Optionale Zuordnung eines Zählers zu einem Mietbereich -->
    <changeSet id="add-zaehler-to-mietbereich" author="kc">
        <addColumn tableName="mietbereich">
            <column name="zaehler_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="mietbereich"
                baseColumnNames="zaehler_id"
                referencedTableName="zaehler"
                referencedColumnNames="id"
                constraintName="fk_mietbereich_zaehler"/>
    </changeSet>

</databaseChangeLog>