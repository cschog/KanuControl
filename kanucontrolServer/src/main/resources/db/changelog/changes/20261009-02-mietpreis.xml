<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="20261009-02-mietpreis" author="chris">

        <createTable tableName="mietpreis">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"
                             primaryKeyName="pk_mietpreis"
                             nullable="false"/>
            </column>

            <column name="mietbereich_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_mietpreis_mietbereich"
                             references="mietbereich(id)"/>
            </column>

            <column name="buchungsquelle" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="gueltig_ab" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="preis" type="NUMERIC(10,2)">
                <constraints nullable="false"/>
            </column>

            <column name="bemerkung" type="VARCHAR(1000)"/>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <column name="created_by" type="VARCHAR(255)"/>

            <column name="last_modified_at" type="TIMESTAMP WITH TIME ZONE"/>

            <column name="last_modified_by" type="VARCHAR(255)"/>

        </createTable>

        <createIndex tableName="mietpreis"
                     indexName="idx_mietpreis_bereich_gueltig">
            <column name="mietbereich_id"/>
            <column name="gueltig_ab"/>
        </createIndex>

        <addUniqueConstraint
                tableName="mietpreis"
                columnNames="mietbereich_id,buchungsquelle,gueltig_ab"
                constraintName="uk_mietpreis_bereich_quelle_gueltig"/>

    </changeSet>

</databaseChangeLog>