<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">
    <changeSet id="20261102-01-mieterverwaltung" author="chris">
        <addColumn tableName="person">
            <column name="kjfp_sichtbar" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <dropNotNullConstraint tableName="person" columnName="sex" columnDataType="CHAR(1)"/>
        <createTable tableName="mieter">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_mieter" nullable="false"/>
            </column>
            <column name="person_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_mieter_person"/>
            </column>
            <column name="aktiv" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="mieter" baseColumnNames="person_id" referencedTableName="person" referencedColumnNames="id" constraintName="fk_mieter_person"/>
        <sql>INSERT INTO mieter (person_id, aktiv) SELECT DISTINCT mieter_id, TRUE FROM buchung WHERE mieter_id IS NOT NULL</sql>
        <rollback>
            <dropTable tableName="mieter"/>
            <dropColumn tableName="person" columnName="kjfp_sichtbar"/>
            <addNotNullConstraint tableName="person" columnName="sex" columnDataType="CHAR(1)"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
