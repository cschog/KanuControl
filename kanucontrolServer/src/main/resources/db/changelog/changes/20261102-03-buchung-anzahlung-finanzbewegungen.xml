<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">
    <changeSet id="20261102-03-buchung-anzahlung-finanzbewegungen" author="chris">
        <addColumn tableName="buchung">
            <column name="anzahlung_betrag" type="DECIMAL(10,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <createTable tableName="buchung_finanzbewegung">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" primaryKeyName="pk_buchung_finanzbewegung" nullable="false"/></column>
            <column name="buchung_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="kategorie" type="VARCHAR(24)"><constraints nullable="false"/></column>
            <column name="art" type="VARCHAR(24)"><constraints nullable="false"/></column>
            <column name="betrag" type="DECIMAL(12,2)"><constraints nullable="false"/></column>
            <column name="datum" type="DATE"><constraints nullable="false"/></column>
            <column name="bemerkung" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="buchung_finanzbewegung" baseColumnNames="buchung_id" referencedTableName="buchung" referencedColumnNames="id" constraintName="fk_buchung_finanzbewegung_buchung" onDelete="CASCADE"/>
        <createIndex tableName="buchung_finanzbewegung" indexName="idx_buchung_finanzbewegung_buchung"><column name="buchung_id"/><column name="datum"/></createIndex>
        <rollback>
            <dropTable tableName="buchung_finanzbewegung"/>
            <dropColumn tableName="buchung" columnName="anzahlung_betrag"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
