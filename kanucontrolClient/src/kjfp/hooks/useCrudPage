// src/hooks/useCrudPage.ts
import { useState } from "react";
import { getApiErrorMessage } from "../api/utils/apiError";

interface CrudApi<T, C> {
  getAll: () => Promise<T[]>;
  create: (dto: C) => Promise<unknown>;
  update: (id: number, dto: C) => Promise<unknown>;
  delete: (id: number) => Promise<void>;
}

export function useCrudPage<T extends { id: number }, C>(api: CrudApi<T, C>) {
  const [data, setData] = useState<T[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const [selected, setSelected] = useState<T | null>(null);
  const [editing, setEditing] = useState<T | null>(null);
  const [dialogOpen, setDialogOpen] = useState(false);
  const [deleteOpen, setDeleteOpen] = useState(false);

  /* ========================================= */

  const load = async () => {
    try {
      setLoading(true);

      setData(await api.getAll());

      setError(null);
    } catch (err: unknown) {
      console.error("Fehler beim Laden der Daten", err);
      setError(getApiErrorMessage(err));
    } finally {
      setLoading(false);
    }
  };

  /* ========================================= */

  const handleAdd = () => {
    setEditing(null);
    setDialogOpen(true);
  };

  /* ========================================= */

  const handleEdit = (row?: T) => {
    const entity = row ?? selected;

    if (!entity) return;

    setEditing(entity);
    setDialogOpen(true);
  };

  /* ========================================= */

  const handleDelete = (row?: T) => {
    if (row) {
      setSelected(row);
    }

    setDeleteOpen(true);
  };

  /* ========================================= */

  const confirmDelete = async () => {
    if (!selected) return;

    try {
      await api.delete(selected.id);

      setDeleteOpen(false);
      setSelected(null);

      await load();
    } catch (err: unknown) {
      console.error("Fehler beim Löschen", err);
      setError(getApiErrorMessage(err));
    }
  };

  /* ========================================= */

  const handleSave = async (dto: C) => {
    try {
      if (editing) {
        await api.update(editing.id, dto);
      } else {
        await api.create(dto);
      }

      setDialogOpen(false);
      setEditing(null);

      await load();
    } catch (err: unknown) {
      console.error("Fehler beim Speichern", err);
      setError(getApiErrorMessage(err));
    }
  };

  /* ========================================= */

  return {
    data,
    loading,
    error,

    selected,
    setSelected,

    editing,

    dialogOpen,
    deleteOpen,

    setDialogOpen,
    setDeleteOpen,

    load,

    handleAdd,
    handleEdit,
    handleDelete,

    confirmDelete,
    handleSave,
  };
}
